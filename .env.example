# Copy to .env for local runs. On Render these are set in render.yaml / the dashboard.
# Only OLA_API_KEY is required.

OLA_API_KEY=
ENVIRONMENT=development          # production hides /docs
LOG_LEVEL=INFO

# Sign-in: off | optional (token checked if sent) | required
AUTH_MODE=optional
FIREBASE_PROJECT_ID=             # the project_id in the app's google-services.json

# Cache + shared rate limits (leave empty to use memory in each process)
REDIS_URL=
# CACHE_DISABLED=false
# CACHE_TTL_SEARCH_SECONDS=86400
# CACHE_TTL_COORDINATES_SECONDS=2592000
# CACHE_TTL_REVERSE_SECONDS=2592000
# CACHE_TTL_ROUTE_SECONDS=120    # 0 = never cache routes
# CACHE_TTL_NEARBY_SECONDS=43200 # nearby safe places (police, hospitals...), per ~1 km square and group

# Rate limits (per minute)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_USER_PER_MINUTE=300
# RATE_LIMIT_ROUTE_PER_MINUTE=30
# RATE_LIMIT_ANONYMOUS_PER_MINUTE=1200
TRUSTED_PROXY_HOPS=0             # 1 behind Render's load balancer

# Ola Maps calls
# OLA_LOOKUP_TIMEOUT_SECONDS=4
# OLA_ROUTE_TIMEOUT_SECONDS=8
# OLA_RETRIES=1
# OLA_MAX_CONNECTIONS=100
# OLA_BREAKER_FAILURES=5
# OLA_BREAKER_COOLDOWN_SECONDS=15

# Nearby safe places (OpenStreetMap Overpass). Several servers, tried in order. Free public service: it is asked
# about a ~1 km square at a time, never the person's exact position, and answers are kept for hours.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# OVERPASS_TIMEOUT_SECONDS=9
